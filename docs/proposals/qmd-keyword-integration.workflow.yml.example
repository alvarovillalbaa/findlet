# INACTIVE EXAMPLE. Root pins the reviewed preparation before QA activation.
name: Findlet actual QMD keyword integration
on: workflow_dispatch
permissions:
  contents: read
concurrency:
  group: findlet-qmd-keyword-20261107-6
  cancel-in-progress: false
jobs:
  keyword-pipeline:
    if: >-
      github.event_name == 'workflow_dispatch' &&
      github.ref == 'refs/heads/qa/findlet-qmd-keyword-20261107-6' &&
      github.repository == 'alvarovillalbaa/findlet' &&
      github.event.repository.private == false
    runs-on: macos-15
    timeout-minutes: 20
    env:
      CI: 'true'
      SOURCE_COMMIT: PREPARATION_SHA_REPLACED_BY_ROOT
      FINDLET_PUBLIC_REPOSITORY: 'true'
    steps:
      - name: Record earliest owned step
        shell: bash
        run: echo "FINDLET_KEYWORD_JOB_STARTED_MS=$(python3 -I -B -S -c 'import time; print(int(time.time()*1000))')" >> "$GITHUB_ENV"
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          ref: ${{ env.SOURCE_COMMIT }}
          fetch-depth: 2
          persist-credentials: false
          clean: false
      - name: Exercise the actual owned-folder keyword pipeline
        shell: bash
        run: python3 -I -B -S Tests/scripts/run-keyword-integration.py --source-commit "$SOURCE_COMMIT"
